{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nammaspace.invalid/contracts/wireframe.schema.json",
  "title": "NammaSpace metric wireframe revision",
  "type": "object",
  "required": ["schemaVersion", "sceneId", "revision", "units", "coordinateFrame", "nodes", "edges", "constraints", "metrics", "reviewState"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "sceneId": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "units": {"type": "string", "enum": ["m", "cm", "ft", "in"]},
    "coordinateFrame": {
      "type": "object",
      "required": ["upAxis", "origin", "handedness"],
      "properties": {
        "upAxis": {"type": "string", "enum": ["X", "Y", "Z"]},
        "origin": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        "handedness": {"type": "string", "enum": ["left", "right"]},
        "worldTransform": {"type": "array", "items": {"type": "number"}, "minItems": 16, "maxItems": 16}
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "position", "source", "locked"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "position": {"$ref": "#/$defs/vec3"},
          "source": {"type": "string", "enum": ["observed", "measured", "inferred", "authored"]},
          "observationCount": {"type": "integer", "minimum": 0},
          "sigma": {"type": ["number", "null"], "minimum": 0},
          "locked": {"type": "boolean"},
          "evidenceIds": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "kind"],
        "properties": {
          "id": {"type": "string"},
          "start": {"type": "string"},
          "end": {"type": "string"},
          "kind": {"type": "string", "enum": ["wall", "opening", "vertical", "room_link"]},
          "expectedLength": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "roomId": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "target", "tolerance", "source", "weight", "status"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string", "enum": ["distance", "parallel", "perpendicular", "coplanar", "shared_edge", "floor_height", "loop_closure", "plan_alignment"]},
          "nodeIds": {"type": "array", "items": {"type": "string"}, "minItems": 2},
          "target": {"type": "number"},
          "tolerance": {"type": "number", "minimum": 0},
          "residual": {"type": ["number", "null"]},
          "source": {"type": "string", "enum": ["laser", "tape", "floor_plan", "sensor", "assumption", "solver"]},
          "weight": {"type": "number", "exclusiveMinimum": 0},
          "status": {"type": "string", "enum": ["satisfied", "violated", "unresolved"]},
          "evidenceIds": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "planes": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "normal", "offset", "rmsResidual", "confidence"], "properties": {"id": {"type": "string"}, "kind": {"type": "string", "enum": ["floor", "ceiling", "wall", "other"]}, "normal": {"$ref": "#/$defs/vec3"}, "offset": {"type": "number"}, "rmsResidual": {"type": ["number", "null"], "minimum": 0}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "supportCount": {"type": "integer", "minimum": 0}}, "additionalProperties": false}},
    "metrics": {
      "type": "object",
      "required": ["computedAt", "constraintRmsResidual", "constraintsSatisfied", "constraintsFailed", "connectedComponents", "coverage", "toleranceProfileId"],
      "properties": {
        "computedAt": {"type": "string", "format": "date-time"},
        "constraintRmsResidual": {"type": ["number", "null"], "minimum": 0},
        "anchorRmsResidual": {"type": ["number", "null"], "minimum": 0},
        "cornerRmsResidual": {"type": ["number", "null"], "minimum": 0},
        "constraintsSatisfied": {"type": "integer", "minimum": 0},
        "constraintsFailed": {"type": "integer", "minimum": 0},
        "connectedComponents": {"type": "integer", "minimum": 0},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "toleranceProfileId": {"type": "string"},
        "readiness": {"type": "string", "enum": ["blocked", "warning", "pass"]}
      },
      "additionalProperties": true
    },
    "reviewState": {"type": "string", "enum": ["generated", "needs_review", "approved", "rejected", "stale"]},
    "parentRevision": {"type": ["integer", "null"], "minimum": 1},
    "inputDimensions": {
      "type": "object",
      "required": ["length", "width", "height"],
      "properties": {"length": {"type": "number", "exclusiveMinimum": 0}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}},
      "additionalProperties": false
    },
    "inputOpenings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "side"],
        "properties": {
          "id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["door", "window", "other"]},
          "side": {"type": "string", "enum": ["side1", "side2", "side3", "side4"]},
          "width": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "height": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "offset_from_corner": {"type": ["number", "null"], "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "provenance": {"type": "object", "properties": {"captureJobId": {"type": "string"}, "engineVersion": {"type": "string"}, "createdBy": {"type": ["string", "null"]}}, "additionalProperties": true}
  },
  "$defs": {
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
  },
  "additionalProperties": false
}
